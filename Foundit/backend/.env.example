# 應用程式
NODE_ENV=development
PORT=3000

# 是否在「物品表為空」時自動寫入示範資料（設為 false 則完全不 seed）
SEED_SAMPLE_DATA=true

# 資料庫
DB_HOST=localhost
DB_PORT=5433
DB_NAME=foundit
DB_USER=foundit_user
DB_PASS=foundit_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# Google 登入：與 Android local.properties 的 GOOGLE_WEB_CLIENT_ID（網頁應用程式 OAuth 用戶端）相同，用於驗證 id_token
# GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com

# 圖片上傳 (本地開發用 local；正式環境換成 s3)
UPLOAD_DRIVER=local
UPLOAD_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=10

# AWS S3（正式環境啟用）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-1
# AWS_S3_BUCKET=

# SMS OTP（開發時僅印 Log；正式環境接 Twilio 或 EVERY8D）
OTP_DRIVER=console
OTP_EXPIRES_MINUTES=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# FCM 推播（正式環境填入）
# FCM_SERVER_KEY=

# App URL（用於 QR Code 連結）
APP_BASE_URL=http://localhost:3000
