# 本機開發用。正式機請用 deploy/.env.example，不要把這份直接拷到伺服器。
# 應用程式
NODE_ENV=development
PORT=3000

# 是否在「物品表為空」時自動寫入示範資料（設為 false 則完全不 seed）
SEED_SAMPLE_DATA=true

# 資料庫
DB_HOST=localhost
DB_PORT=5433
DB_NAME=foundit
DB_USER=foundit_user
DB_PASS=foundit_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT。正式環境若缺失、短於 32 字或仍是範例值，服務會拒絕啟動。
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# 逗號分隔的管理員手機。只在登入時提升權限，不能由 App 自稱角色。
# ADMIN_PHONES=0912345678

# 正式環境的瀏覽器來源。手機 App 不依賴 CORS。留空代表不開放瀏覽器跨站。
# CORS_ORIGINS=https://foundit.example

# Google 登入：與 Android local.properties 的 GOOGLE_WEB_CLIENT_ID（網頁應用程式 OAuth 用戶端）相同，用於驗證 id_token
# GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com

# 圖片上傳 (本地開發用 local；正式環境換成 s3)
UPLOAD_DRIVER=local
UPLOAD_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=10

# AWS S3（正式環境啟用）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-1
# AWS_S3_BUCKET=

# SMS OTP。development 可用 console；production 若仍是 console 會拒絕啟動。
# 設為 twilio 時必須另外提供 TWILIO_ACCOUNT_SID、TWILIO_AUTH_TOKEN、TWILIO_FROM_NUMBER，否則寄送會失敗而不是回報成功。
OTP_DRIVER=console
OTP_EXPIRES_MINUTES=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# FCM 推播：Firebase 主控台 → 專案設定 → 服務帳戶 → 產生新的私密金鑰。
# 二選一：JSON 檔路徑，或整份 JSON 的 base64（單行，適合放 .env）。留空則停用推播。
# FCM_SERVICE_ACCOUNT_FILE=
# FCM_SERVICE_ACCOUNT_JSON=

# App URL（用於 QR Code 連結）
APP_BASE_URL=http://localhost:3000

# 管理員名單：手機登入用 ADMIN_PHONES，Google 登入用 ADMIN_EMAILS（逗號分隔）
ADMIN_PHONES=
ADMIN_EMAILS=
