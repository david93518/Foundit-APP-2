# 伺服器上的正式環境變數。複製成 /opt/foundit/.env 後再填，不要提交 .env。
# JWT_SECRET、DB_PASS 請各用 openssl rand -base64 32 產生。範例文字在正式環境會拒絕啟動。

NODE_ENV=production
# Optional explicitly provisioned ordinary account. All four values required.
# Hash format: scrypt:<16-byte salt hex>:<64-byte derived key hex>, N=16384,r=8,p=1.
# Keep plaintext passwords outside source control. The DB user must already
# exist with role=user, status=active, phone=invited:<username>, google_sub=NULL.
# ISO-8601 expiry; missing/expired/invalid values disable this login method.
# To revoke existing sessions too, suspend the account and increment token_version.
INVITED_LOGIN_USERNAME=
INVITED_LOGIN_USER_ID=
INVITED_LOGIN_PASSWORD_HASH=
INVITED_LOGIN_EXPIRES_AT=
PORT=3000
SEED_SAMPLE_DATA=false

DB_HOST=postgres
DB_PORT=5432
DB_NAME=foundit
# 最小權限：API 執行時用 DB_USER（只能讀寫資料，見 scripts/db-least-privilege.sql）；
# 建表、改欄位的 migration 用 DB_MIGRATION_USER（資料庫擁有者）。兩者留同一組也能跑，但 API 會握有超級使用者權限。
DB_MIGRATION_USER=foundit_user
DB_MIGRATION_PASS=change-me-to-a-long-random-password
DB_USER=foundit_app
DB_PASS=change-me-to-a-different-long-random-password

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=change-me-to-a-different-long-random-secret
JWT_EXPIRES_IN=7d

# 可選的管理員登入允許名單，不會自動提升權限。新管理員需由資料庫擁有者執行 provision-admin.sql。
ADMIN_PHONES=
# 管理員：Google 驗證過的 email（逗號分隔，不分大小寫）；名單外的管理員會被拒絕登入。
ADMIN_EMAILS=

CORS_ORIGINS=https://foundit.tw,https://www.foundit.tw

# 代理帶來的真實來源 IP 標頭（限流用）。只有 TCP 對端是本機／私有網段時才採信。
# Cloudflare Tunnel：cf-connecting-ip；nginx（docker-compose.yml）：x-real-ip
CLIENT_IP_HEADER=cf-connecting-ip
# Exact TCP proxy peers only. Include the Docker gateway address verified on the host;
# do not list an entire private subnet. Unlisted peers cannot supply client-IP headers.
TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# API 對外綁定位址。Tunnel 跑在同一台主機時維持 127.0.0.1，不要讓區網直接連 3000。
API_BIND_ADDR=127.0.0.1
# 正式環境預設不提供 /api/docs；除錯時才暫時設 true。
SWAGGER_ENABLED=false
# 舊版 Engine.IO v3 用戶端相容；Flutter App 不需要。
SOCKET_ALLOW_EIO3=false

GOOGLE_WEB_CLIENT_ID=

# Explicit place searches only; HTTPS Nominatim-compatible provider.
# Default public provider uses an in-process global queue (one API replica only).
# Multiple replicas need a shared limiter or a provider with suitable capacity.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

UPLOAD_DRIVER=local
MAX_FILE_SIZE_MB=10

OTP_DRIVER=disabled
OTP_EXPIRES_MINUTES=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# FCM 推播：Firebase 服務帳戶 JSON 的 base64（單行）。產生方式：
#   base64 -w0 foundit-873c1-firebase-adminsdk.json
# 留空則停用推播，聊天仍可在 App 內使用。
FCM_SERVICE_ACCOUNT_JSON=

# QR 與圖片網址的公開來源
APP_BASE_URL=https://api.foundit.tw

# 掃描貼紙落地頁的「下載 FOUND !T」按鈕（App Store 或 TestFlight 公開連結，只接受 https；留空則不顯示）
APP_DOWNLOAD_URL=
# Universal Links：<Apple Team ID>.<bundle id>，逗號分隔；預設為正式 App
IOS_APP_IDS=3X8U3KP7SH.com.david93518.foundit
# Android App Links：<package>=<release 簽章 SHA-256>，逗號分隔；留空則不提供 assetlinks.json
ANDROID_APP_LINKS=

# Let's Encrypt 通知信箱，憑證申請必填
LETSENCRYPT_EMAIL=
